# ---------- 飞书 ----------
# 开放平台 → 你的企业自建应用 →「凭证与基础信息」
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 国际版 Lark 填 https://open.larksuite.com
FEISHU_DOMAIN=https://open.feishu.cn
# 群里是否必须 @ 机器人才响应
FEISHU_REQUIRE_MENTION_IN_GROUP=true
# 机器人自己的 open_id（可选）。不填的话，群消息里 @ 了任何人机器人都会响应
# FEISHU_BOT_OPEN_ID=

# ---------- 模型（OpenAI 兼容接口） ----------
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
# 改用 Claude：LLM_PROVIDER=anthropic，并 pip install anthropic
# ANTHROPIC_API_KEY=

# ---------- 飞书官方工具集（MCP，可选，需要 Node.js） ----------
MCP_ENABLED=false
MCP_TOOL_PRESETS=preset.default
MCP_TOKEN_MODE=tenant_access_token

# ---------- Agent ----------
AGENT_MAX_TOOL_ROUNDS=8
AGENT_TIMEOUT_SECONDS=300
HANDLER_WORKERS=8
SESSION_MAX_MESSAGES=20
SESSION_TTL_SECONDS=3600
# 自定义 HTTP 工具声明文件
CUSTOM_TOOLS_FILE=custom_tools.json
# 系统提示词文件；文件不存在时用内置的通用提示词
SYSTEM_PROMPT_FILE=system_prompt.md
# 钩子模块，逗号分隔
# HOOKS_MODULES=examples.confirm_gate
# 机器人建的文档自动把所有者转给发起人
AUTO_TRANSFER_OWNER=true
LOG_LEVEL=INFO

# ---------- 示例工具用到的变量（跑 examples/demo_api_server.py 时用） ----------
DEMO_API_BASE=http://127.0.0.1:8090
DEMO_API_TOKEN=demo-token
